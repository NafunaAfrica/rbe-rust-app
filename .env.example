# Copy to `.env` and fill in. `.env` is gitignored - never commit real secrets.

# --- Server ---
RBE_BIND_ADDR=0.0.0.0:8080
RBE_DATA_DIR=./data/surreal
RBE_PUBLIC_BASE_URL=http://localhost:8080

# --- Admin login (single account) ---
RBE_JWT_SECRET=change-me-to-a-long-random-string
RBE_ADMIN_EMAIL=admin@rbe.club
RBE_ADMIN_PASSWORD=change-me

# --- Shopify (catalog visibility + checkout) ---
SHOPIFY_STORE_DOMAIN=f0epji-nd.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2026-07

# App secret (`shpss_...`) used to verify inbound Shopify webhook HMACs.
# The app currently also falls back to this for admin token exchange if
# SHOPIFY_CLIENT_SECRET is not set explicitly.
SHOPIFY_WEBHOOK_SECRET=

# App client id / API key from the Shopify app.
# Used for Shopify Admin API client-credentials exchange.
SHOPIFY_API_KEY=

# Optional explicit names if you prefer them over the fallback keys above.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- Printify (legacy while transitioning providers) ---
PRINTIFY_API_TOKEN=
PRINTIFY_WEBHOOK_SECRET=

# --- Agent (rig) ---
# Set to enable the site agent scaffold. Leave empty to keep it disabled.
ANTHROPIC_API_KEY=
RBE_AGENT_MODEL=claude-sonnet-5
